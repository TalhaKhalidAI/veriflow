{
  "expo": {
    "name": "VeriFlow",
    "slug": "veriflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "scheme": "veriflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07111D",
        "foregroundImage": "./src/assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.veriflow",
      "usesCleartextTraffic": true
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07111D",
          "image": "./src/assets/title1.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow VeriFlow to use the camera to scan signed QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite",
      "react-native-quick-crypto"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}